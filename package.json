  "bugs": {
    "url": "https://github.com/TracyGJG/utilities/issues"
  },
  "homepage": "https://github.com/TracyGJG/utilities#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "happy-dom": "20.10.6"
  },
  "c8": {
    "exclude": [
      "**/*.test.*"
    ],
    "reporter": [
      "lcov"
    ]
